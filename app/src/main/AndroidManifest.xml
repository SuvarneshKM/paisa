<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Explicitly required for offline bank alert transaction processing. -->
    <!-- Strictly NO READ_SMS, NO SEND_SMS, NO INTERNET permissions requested. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Inform Google Play / Android that telephony hardware is optional (enables tablets/Chromebooks) -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Required for transaction categorization notifications on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Paisa">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Paisa"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Minimal Category Picker Activity opened by "More" / "Other" notification action -->
        <activity
            android:name=".notification.CategoryPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Paisa"
            android:launchMode="singleTop" />

        <!-- BroadcastReceiver for incoming SMS bank alerts -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for quick category notification actions -->
        <receiver
            android:name=".notification.TransactionActionReceiver"
            android:exported="false" />

    </application>

</manifest>
